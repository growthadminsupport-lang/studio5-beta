// GrowTH — Database Architecture (Volume 06 of Process of project.txt)
// PostgreSQL 16+, Prisma ORM, UUID primary keys, soft delete on medical records.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & Access
// ---------------------------------------------------------------------------

/// Account-level role. Whether someone is a parent, caretaker or doctor *for a given child*
/// lives on ChildGuardian.role; this only records what needs checking across all children:
/// that a doctor has been approved, and who can open the admin portal.
enum UserRole {
  USER
  DOCTOR
  ADMIN
}

enum DoctorStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                   String        @id @default(uuid())
  email                String        @unique
  /// Null for accounts that only ever signed in with Google. `login` rejects those before
  /// it reaches bcrypt, so a null hash can never be compared against a submitted password.
  passwordHash         String?
  fullName             String
  phoneNumber          String?
  role                 UserRole      @default(USER)
  /// Doctor accounts only. An admin approves them before they can accept an invitation or
  /// upload an X-ray.
  doctorStatus         DoctorStatus?
  licenseNumber        String?
  hospital             String?
  /// Shown to the doctor when an application is rejected.
  doctorReviewNote     String?
  avatarUrl            String?
  /// The address is proven to belong to this person: Google said so, or the confirmation
  /// link we emailed was opened.
  isVerified           Boolean       @default(false)
  emailVerifyTokenHash String?       @unique
  emailVerifyExpiresAt DateTime?
  termsAcceptedAt      DateTime?
  resetTokenHash       String?
  resetTokenExpiresAt  DateTime?
  /// Google's stable subject claim. Stored so a user who later changes their Google account
  /// email still resolves to the same account, and so linking is auditable.
  googleId             String?       @unique
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?

  children        ChildGuardian[]
  invitesSent     ChildInvite[]    @relation("InvitesSent")
  sessions        Session[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  supportMessages SupportMessage[]

  @@map("users")
}

model Session {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String    @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?
  /// Set when this token was exchanged for a new pair (rotation), as opposed to revoked by
  /// logout or a password change. A rotated token is still accepted for a few seconds; see
  /// AuthService.refresh.
  rotatedAt    DateTime?

  @@index([userId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Family / Child
// ---------------------------------------------------------------------------

enum ChildSex {
  MALE
  FEMALE
}

/// What a person may do for one child. See docs/user-flows.md for the full matrix.
enum ChildRole {
  PARENT
  CARETAKER
  DOCTOR
}

enum GuardianRelation {
  PARENT
  GUARDIAN
  RELATIVE
}

model Child {
  id          String    @id @default(uuid())
  fullName    String
  nickname    String?
  sex         ChildSex
  dateOfBirth DateTime
  avatarUrl   String?
  /// The illustrated avatar: { skin, hair, hairColor }. The baby or young-child drawing is
  /// chosen from the age, so it grows with the child.
  avatar      Json?
  /// Hospital number. Set by the parent or the child's doctor; doctors find patients by it.
  hn          String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  guardians          ChildGuardian[]
  invites            ChildInvite[]
  growthRecords      GrowthRecord[]
  pubertyScreenings  PubertyScreening[]
  boneAgePredictions BoneAgePrediction[]

  @@index([hn])
  @@map("children")
}

model ChildGuardian {
  id        String           @id @default(uuid())
  childId   String
  child     Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// What this person may do for this child. `relation` below is only how a parent describes
  /// themselves (parent, guardian, relative) and grants nothing.
  role      ChildRole        @default(PARENT)
  relation  GuardianRelation @default(PARENT)
  isPrimary Boolean          @default(true)
  createdAt DateTime         @default(now())

  @@unique([childId, userId])
  @@index([userId])
  @@map("child_guardians")
}

/// A parent's invitation for a caretaker or doctor to join one child. Single use, expires.
/// Only a hash of the token is stored: the link itself is the credential.
model ChildInvite {
  id           String    @id @default(uuid())
  childId      String
  child        Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  role         ChildRole
  tokenHash    String    @unique
  /// Where the invitation was emailed, if anywhere. The QR code path has none.
  email        String?
  invitedById  String
  invitedBy    User      @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([childId])
  @@map("child_invites")
}

// ---------------------------------------------------------------------------
// Growth Tracking
// ---------------------------------------------------------------------------

model GrowthRecord {
  id                          String    @id @default(uuid())
  childId                     String
  child                       Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  measuredAt                  DateTime  @default(now())
  heightCm                    Decimal?  @db.Decimal(5, 2)
  weightKg                    Decimal?  @db.Decimal(5, 2)
  bmi                         Decimal?  @db.Decimal(4, 2)
  heightPercentile            Decimal?  @db.Decimal(5, 2)
  weightPercentile            Decimal?  @db.Decimal(5, 2)
  bmiPercentile               Decimal?  @db.Decimal(5, 2)
  heightSds                   Decimal?  @db.Decimal(4, 2)
  weightSds                   Decimal?  @db.Decimal(4, 2)
  bmiSds                      Decimal?  @db.Decimal(4, 2)
  /// BMI as a percentage of the 95th percentile. CDC's severity metric above P95, and the
  /// only one that still resolves once the percentile itself has saturated at 100.
  bmiPctOfP95                 Decimal?  @db.Decimal(5, 1)
  /// Head circumference, infants only. The measure that fills the gap below two years, where
  /// BMI-for-age does not apply. AAP measures it to 24 months; CDC's table runs to 36.
  headCircumferenceCm         Decimal?  @db.Decimal(5, 2)
  headCircumferencePercentile Decimal?  @db.Decimal(5, 2)
  headCircumferenceSds        Decimal?  @db.Decimal(4, 2)
  note                        String?
  /// Who entered it: parent, caretaker or doctor. Informational, so no foreign key; it stays
  /// readable if that account is later deleted.
  recordedById                String?
  createdAt                   DateTime  @default(now())
  deletedAt                   DateTime?

  @@index([childId, measuredAt])
  @@map("growth_records")
}

// ---------------------------------------------------------------------------
// Puberty Screening (Tanner Staging)
// ---------------------------------------------------------------------------

enum TannerStage {
  STAGE_1
  STAGE_2
  STAGE_3
  STAGE_4
  STAGE_5
}

model PubertyScreening {
  id            String       @id @default(uuid())
  childId       String
  child         Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  tannerStage   TannerStage?
  answers       Json
  notes         String?
  /// Who filled it in. A caretaker's submission notifies the parents and doctors, who read
  /// the result themselves.
  submittedById String?
  assessedAt    DateTime     @default(now())
  createdAt     DateTime     @default(now())

  @@index([childId, assessedAt])
  @@map("puberty_screenings")
}

// ---------------------------------------------------------------------------
// AI Bone Age (stub — real inference wired in later by AI team)
// ---------------------------------------------------------------------------

/// The doctor's reading of a bone-age record, which is what parents and caretakers see.
enum BoneAgeReview {
  NORMAL
  ADVANCED
  DELAYED
}

enum BoneAgePredictionStatus {
  PENDING
  COMPLETED
  FAILED
}

model BoneAgePrediction {
  id                     String                  @id @default(uuid())
  childId                String
  child                  Child                   @relation(fields: [childId], references: [id], onDelete: Cascade)
  imageUrl               String
  status                 BoneAgePredictionStatus @default(PENDING)
  predictedAgeMonths     Int?
  confidenceScore        Decimal?                @db.Decimal(4, 3)
  modelVersion           String?
  /// Why a FAILED prediction failed. Distinguishes "that image was unreadable" from "the
  /// model is offline", which need different things from the parent.
  failureReason          String?
  /// Only a doctor uploads. Informational, so no foreign key.
  uploadedById           String?
  /// The day the X-ray was taken. Chronological age is measured at this date, not at upload,
  /// so a film uploaded months later is still compared with the child's age on the day.
  examDate               DateTime                @default(now())
  /// The child's age in months on examDate, computed with the same function as growth records.
  chronologicalAgeMonths Int?
  /// Set by the doctor. Null until reviewed, and parents and caretakers see nothing until then.
  review                 BoneAgeReview?
  doctorNote             String?
  reviewedAt             DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @default(now()) @updatedAt
  completedAt            DateTime?

  @@index([childId, createdAt])
  @@map("bone_age_predictions")
}

// ---------------------------------------------------------------------------
// Knowledge Center
// ---------------------------------------------------------------------------

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  slug     String    @unique
  articles Article[]

  @@map("categories")
}

model Article {
  id            String    @id @default(uuid())
  categoryId    String
  category      Category  @relation(fields: [categoryId], references: [id])
  title         String
  slug          String    @unique
  summary       String
  contentMd     String
  coverImageUrl String?
  tag           String?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bookmarks Bookmark[]

  @@index([categoryId])
  @@map("articles")
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, articleId])
  @@map("bookmarks")
}

// ---------------------------------------------------------------------------
// Notifications / Audit
// ---------------------------------------------------------------------------

enum NotificationType {
  MEASUREMENT_REMINDER
  BONE_AGE_RESULT
  PUBERTY_MILESTONE
  SYSTEM
  PUBERTY_SUBMITTED
  INVITE_ACCEPTED
  DOCTOR_REVIEWED
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  /// The child it is about, so the app can open the right child. Null for account notices.
  childId   String?
  title     String
  body      String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("audit_logs")
}

enum SupportKind {
  CONTACT
  PROBLEM
}

enum SupportStatus {
  NEW
  READ
  RESOLVED
}

model SupportMessage {
  id        String        @id @default(uuid())
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind      SupportKind   @default(CONTACT)
  status    SupportStatus @default(NEW)
  email     String
  subject   String
  message   String
  /// Problem reports only: the page and child the user was on.
  context   Json?
  createdAt DateTime      @default(now())

  @@index([createdAt])
  @@map("support_messages")
}

// ---------------------------------------------------------------------------
// Rate limiting
// ---------------------------------------------------------------------------

/// Shared throttle counters. In-process storage under-counts whenever more than one
/// instance is serving, which is exactly what happened on Render — see PrismaThrottlerStorage.
model RateLimit {
  key          String    @id
  hits         Int       @default(0)
  expiresAt    DateTime  @db.Timestamptz(3)
  blockedUntil DateTime? @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("rate_limits")
}
