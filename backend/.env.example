DATABASE_URL="postgresql://growth:growth_dev_pw@localhost:5432/growth?schema=public"

JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=3001
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"

# Password reset email, via Resend's HTTP API. Render blocks outbound SMTP ports, so HTTP is
# the only transport that works there.
#
# Leave RESEND_API_KEY unset in local dev: forgot-password then returns the reset token
# directly in the response instead of emailing it. That fallback is disabled in production.
RESEND_API_KEY=
MAIL_FROM="GrowTH <onboarding@resend.dev>"

# The account that gets the admin portal. Promoted by the seed on each deploy, but only once
# its email is verified: sign in with Google as this address first, then redeploy.
ADMIN_EMAIL=
# Seed one demo account per role (password Demo1234!) sharing one child. Never in production.
SEED_DEMO=false
# Secret for the child pseudonyms in the admin CSV export. Falls back to JWT_ACCESS_SECRET.
EXPORT_SALT=
