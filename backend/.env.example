DATABASE_URL="postgresql://growth:growth_dev_pw@localhost:5432/growth?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=3001
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"

# Password reset emails. Leave both unset in local dev — forgot-password will fall back
# to returning the reset token directly in the API response instead of emailing it.
#
# Preferred: Resend (HTTP API — works on hosts like Render that block outbound SMTP ports).
RESEND_API_KEY=
SMTP_FROM="GrowTH <onboarding@resend.dev>"
#
# Fallback: raw SMTP (only reachable on hosts that allow outbound SMTP, e.g. local dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
