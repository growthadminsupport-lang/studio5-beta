# Model weights are never committed. An EfficientNet-B0 checkpoint is ~20 MB of binary that
# git cannot diff or compress, every clone would pay for it forever, and each retrain would
# add another copy. Weights are distributed as GitHub Release assets instead — see
# ai-service/README.md.
*.pt
*.pth
*.onnx
*.h5
*.ckpt
*.safetensors
ai-service/models/*
!ai-service/models/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Local env
.env
.env.*
!.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
