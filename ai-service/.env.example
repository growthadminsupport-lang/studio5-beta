# Version string recorded against every prediction, so an old result stays interpretable
# after a retrain.
MODEL_VERSION=effnetb0-v1-rsna

# Mean absolute error in months on the held-out test set. The UI shows this as the "±"
# margin next to the estimate (TOR FR-18), so it must be the real measured figure.
MAE_MONTHS=0

# Path to the checkpoint. Not committed — see README.
MODEL_PATH=models/bone_age_effnetb0.pt
